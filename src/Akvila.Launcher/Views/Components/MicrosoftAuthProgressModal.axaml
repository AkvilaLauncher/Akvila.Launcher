<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Akvila.Launcher.ViewModels.Components"
             xmlns:components="clr-namespace:Akvila.Launcher.Views.Components"
             xmlns:lang="clr-namespace:Akvila.Launcher.Assets.Resources"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:MicrosoftAuthProgressModalModel"
             x:Class="Akvila.Launcher.Views.Components.MicrosoftAuthProgressModal">

    <Border Background="{StaticResource BackgroundOverlay}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

        <!-- Modal Content -->
        <components:StackFrameBorder VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Width="350"
                                     Spacing="20">

            <StackPanel Classes="MarginBottom">
                <TextBlock Text="{x:Static lang:Resources.MicrosoftLogin}"
                           Classes="FormText"
                           HorizontalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold" />
            </StackPanel>

            <StackPanel Classes="MarginBottom" Spacing="5">
                <!-- Authentication status -->
                <TextBlock Text="{Binding StatusMessage}"
                           Classes="FormText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="14" />

                <!-- Current stage -->
                <TextBlock Text="{Binding CurrentStageName}"
                           Classes="FormText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="16"
                           Margin="0,0,0,10" />

                <!-- Spinning progress indicator -->
                <ProgressBar IsIndeterminate="True"
                             Classes="ProgressBar"
                             IsVisible="{Binding !HasError}"
                             Margin="0,10,0,0"
                             Height="3" />
            </StackPanel>

            <!-- Error message -->
            <Border Background="{StaticResource ErrorBackgroundColor}"
                    BorderBrush="{StaticResource ErrorColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15"
                    IsVisible="{Binding HasError}"
                    Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Authentication Error"
                               Foreground="{StaticResource ErrorColor}"
                               FontWeight="Bold"
                               FontSize="14" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Classes="FormText"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="15">

                <components:AkvilaButton Command="{Binding RetryCommand}"
                                         Classes="TextIcon Primary"
                                         IconPath="/Assets/Images/refresh.svg"
                                         IconSize="16"
                                         Text="Retry"
                                         IsVisible="{Binding HasError}" />

                <components:AkvilaButton Command="{Binding CancelCommand}"
                                         Classes="TextIcon Secondary"
                                         IconPath="/Assets/Images/back.svg"
                                         IconSize="16"
                                         Text="{x:Static lang:Resources.Cancel}" />
            </StackPanel>

        </components:StackFrameBorder>
    </Border>
</UserControl>
