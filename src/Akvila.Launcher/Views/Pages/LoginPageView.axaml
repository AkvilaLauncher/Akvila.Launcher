<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Akvila.Launcher.ViewModels.Pages"
             xmlns:lang="clr-namespace:Akvila.Launcher.Assets.Resources"
             xmlns:components="clr-namespace:Akvila.Launcher.Views.Components"
             xmlns:converters="clr-namespace:Akvila.Launcher.Core.Converters"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:DataType="vm:LoginPageViewModel"
             x:Class="Akvila.Launcher.Views.Pages.LoginPageView">

    <Grid>
        <!-- Background -->
        <!-- <components:BackgroundComponent /> -->

        <components:StackFrameBorder VerticalAlignment="Center"
                                     HorizontalAlignment="Center"
                                     Width="380"
                                     Spacing="20">

            <StackPanel Classes="MarginBottom">
                <components:LogoComponent Classes="TextLogo"
                                          HorizontalAlignment="Center" />
            </StackPanel>

            <Border Classes="Separator" />

            <StackPanel Classes="MarginBottom" IsVisible="{Binding ShowInfoMessage}">
                <TextBlock Text="{Binding InfoMessage}"
                           Classes="FormText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="Tomato"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Classes="MarginBottom" IsVisible="{Binding ShowLoginFields}">
                <TextBlock Text="{x:Static lang:Resources.Login}"
                           Classes="FormText" />
                <TextBox Classes="FormBox" Text="{Binding Login}" />
            </StackPanel>

            <StackPanel Classes="MarginBottom" IsVisible="{Binding ShowPasswordField}">
                <TextBlock Text="{x:Static lang:Resources.Password}"
                           Classes="FormText" />
                <TextBox Classes="FormBox"
                         PasswordChar="•"
                         Text="{Binding Password}" />
            </StackPanel>

            <TextBlock Text="{Binding Errors, Converter={converters:FirstElementConverter}}"
                       IsVisible="{Binding Errors, Converter={converters:HasElementsConverter}}"
                       Foreground="Tomato"
                       Margin="0, 0, 0, 20" />

            <components:AkvilaButton Command="{Binding LoginCommand}"
                                     HorizontalAlignment="Center"
                                     IsDefault="True"
                                     IsVisible="{Binding ShowStandardLoginButton}"
                                     Classes="TextIcon Primary"
                                     IconPath="/Assets/Images/login.svg"
                                     IconSize="24"
                                     FontWeight="Bold"
                                     Text="{x:Static lang:Resources.AuthButtonText}" />

            <components:AkvilaButton Command="{Binding MicrosoftLoginCommand}"
                                     HorizontalAlignment="Center"
                                     IsDefault="True"
                                     IsVisible="{Binding ShowMicrosoftLoginButton}"
                                     Classes="TextIcon Primary"
                                     IconPath="/Assets/Images/microsoft.svg"
                                     IconSize="16"
                                     FontWeight="Bold"
                                     Text="{x:Static lang:Resources.MicrosoftLogin}" />

            <!-- Loading indicator -->
            <ProgressBar IsIndeterminate="{Binding IsProcessing}"
                         Classes="ProgressBar"
                         IsVisible="{Binding IsProcessing}"
                         Margin="23"
                         Height="1"
                         VerticalAlignment="Bottom" />

        </components:StackFrameBorder>

        <Border IsVisible="{Binding IsShowingMicrosoftModal}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="100">
            <components:MicrosoftAuthModal DataContext="{Binding MicrosoftAuthModal}" />
        </Border>

        <Border IsVisible="{Binding IsShowingMicrosoftProgressModal}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ZIndex="100">
            <components:MicrosoftAuthProgressModal DataContext="{Binding MicrosoftAuthProgressModal}" />
        </Border>
    </Grid>
</UserControl>
